# Configuração da API do Gemini (obrigatório)
gemini-api-key=SUA_CHAVE_GEMINI_AQUI

# Configurações de email (opcionais - para envio de PDF por email)
# Para Gmail, use uma senha de aplicativo: https://myaccount.google.com/apppasswords
SENDER_EMAIL=seu_email@gmail.com
SENDER_PASSWORD=sua_senha_de_aplicativo

# Configurações SMTP (opcionais - padrões para Gmail)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587

# Para outros provedores de email, ajuste as configurações SMTP:
# Outlook/Hotmail: smtp.live.com, porta 587
# Yahoo: smtp.mail.yahoo.com, porta 587
# Outros: consulte a documentação do seu provedor